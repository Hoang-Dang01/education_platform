// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  manager
  teacher
  student
}

enum MaterialScope {
  course
  personal
}

model User {
  id                 String            @id @default(uuid())
  email              String?           @unique
  username           String            @unique
  password           String
  name               String
  role               UserRole
  status             String            @default("active") // 'active' | 'suspended'
  lastActive         String            @default("Đang hoạt động")
  mustChangePassword Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  // Relations
  classes           Class[]           @relation("TeacherClasses")
  enrollments       Enrollment[]
  attendances       Attendance[]
  telemetrySamples  TelemetrySample[]
  studentProfile    StudentProfile?
  uploadedMaterials CourseMaterial[]  @relation("UserMaterials")
}

model StudentProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentCode String    @unique // STU-2026-00125
  phone       String?
  dob         DateTime?
  cccd        String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Course {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  description String?
  status      String           @default("active") // 'active' | 'inactive'
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  
  // Relations
  classes   Class[]
  materials CourseMaterial[]
}

model Class {
  id            String   @id @default(uuid())
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name          String
  teacherId     String
  teacher       User     @relation("TeacherClasses", fields: [teacherId], references: [id])
  status        String   @default("scheduled") // 'scheduled' | 'ongoing' | 'completed'
  earlyJoinMins Int      @default(15)
  lateJoinMins  Int?     // NULL means allow join anytime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  enrollments Enrollment[]
  sessions    Session[]
}

model Enrollment {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  classId    String
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  status     String   @default("active") // 'active' | 'dropped'
  enrolledAt DateTime @default(now())

  @@unique([userId, classId])
}

model Session {
  id        String    @id @default(uuid())
  classId   String
  class     Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  roomName  String    @unique // Random UUID generated by backend
  startTime DateTime?
  endTime   DateTime?
  status    String    @default("scheduled") // 'scheduled' | 'live' | 'ended'
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  attendances      Attendance[]
  telemetrySamples TelemetrySample[]
}

model Attendance {
  id                     String   @id @default(uuid())
  sessionId              String
  session                Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  presentTimeMins        Int      @default(0)
  totalTimeMins          Int      @default(0)
  pct                    Float    @default(0.0)
  disconnectCount        Int      @default(0)
  disconnectDurationMins Int      @default(0)
  avgPing                Float    @default(0.0)
  avgLoss                Float    @default(0.0)
  avgJitter              Float    @default(0.0)
  status                 String   @default("fail") // 'pass' | 'fail'
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([sessionId, userId])
}

model CourseMaterial {
  id           String        @id @default(uuid())
  courseId     String?
  course       Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title        String
  fileName     String
  fileType     String        // 'pdf' | 'slide' | 'video' | 'image'
  fileSize     String
  filePath     String
  uploadedAt   DateTime      @default(now())
  uploadedById String
  uploadedBy   User          @relation("UserMaterials", fields: [uploadedById], references: [id], onDelete: Cascade)
  isPrivate    Boolean       @default(false)
  scope        MaterialScope @default(course)
  isDeleted    Boolean       @default(false)
}

model TelemetrySample {
  id          String   @id @default(uuid())
  sessionId   String
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pingMs      Float
  packetLoss  Float
  jitterMs    Float
  bitrateKbps Float?
  fps         Float?
  createdAt   DateTime @default(now())
}
