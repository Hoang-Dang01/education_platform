# ============================================================
#  EduMeet — Jitsi Meet Self-Hosted Configuration
#  Sao chép file này thành .env và điền thông tin của bạn
# ============================================================

# -------------------------------------------------------
# [BẮT BUỘC] IP public của server của bạn
# Ví dụ: DOCKER_HOST_ADDRESS=203.0.113.42
# -------------------------------------------------------
DOCKER_HOST_ADDRESS=YOUR_SERVER_IP

# -------------------------------------------------------
# [BẮT BUỘC] IP public để JVB advertise cho WebRTC clients
# Thường giống DOCKER_HOST_ADDRESS
# -------------------------------------------------------
JVB_ADVERTISE_IPS=YOUR_SERVER_IP

# -------------------------------------------------------
# [BẮT BUỘC] URL công khai để trình duyệt kết nối
# Vì không có domain, dùng IP + port
# -------------------------------------------------------
PUBLIC_URL=https://YOUR_SERVER_IP:8443

# -------------------------------------------------------
# Cấu hình thư mục lưu trữ config của Jitsi
# -------------------------------------------------------
CONFIG=./jitsi-config

# -------------------------------------------------------
# Ports
# -------------------------------------------------------
HTTP_PORT=8080
HTTPS_PORT=8443
JVB_PORT=10000

# -------------------------------------------------------
# Timezone
# -------------------------------------------------------
TZ=Asia/Ho_Chi_Minh

# -------------------------------------------------------
# XMPP Domain — dùng noxmpp.edumeet (nội bộ Docker)
# Không cần phải là domain thật
# -------------------------------------------------------
XMPP_DOMAIN=meet.edumeet.local
XMPP_SERVER=xmpp.meet.edumeet.local
XMPP_AUTH_DOMAIN=auth.meet.edumeet.local
XMPP_MUC_DOMAIN=conference.meet.edumeet.local
XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.edumeet.local
XMPP_GUEST_DOMAIN=guest.meet.edumeet.local
XMPP_RECORDER_DOMAIN=recorder.meet.edumeet.local
XMPP_BOSH_URL_BASE=http://xmpp.meet.edumeet.local:5280
XMPP_PORT=5222

# -------------------------------------------------------
# [BẮT BUỘC] Passwords — PHẢI THAY bằng passwords ngẫu nhiên
# Chạy: ./gen-passwords.sh để tự động sinh
# -------------------------------------------------------
JICOFO_AUTH_USER=focus
JICOFO_AUTH_PASSWORD=CHANGE_ME_JICOFO_PASSWORD
JICOFO_COMPONENT_SECRET=CHANGE_ME_COMPONENT_SECRET

JVB_AUTH_USER=jvb
JVB_AUTH_PASSWORD=CHANGE_ME_JVB_PASSWORD

JIBRI_XMPP_USER=jibri
JIBRI_XMPP_PASSWORD=CHANGE_ME_JIBRI_XMPP_PASSWORD
JIBRI_RECORDER_USER=recorder
JIBRI_RECORDER_PASSWORD=CHANGE_ME_JIBRI_RECORDER_PASSWORD

JIGASI_XMPP_USER=jigasi
JIGASI_XMPP_PASSWORD=CHANGE_ME_JIGASI_PASSWORD

# -------------------------------------------------------
# JVB Brewery MUC (nơi JVB đăng ký vào Jicofo)
# -------------------------------------------------------
JVB_BREWERY_MUC=jvbbrewery
JIBRI_BREWERY_MUC=jibribrewery
JIGASI_BREWERY_MUC=jigasibrewery

# -------------------------------------------------------
# Tắt các tính năng không dùng (giảm độ phức tạp)
# -------------------------------------------------------
ENABLE_AUTH=0
ENABLE_GUESTS=1
ENABLE_LOBBY=0
ENABLE_RECORDING=0
ENABLE_TRANSCRIPTIONS=0
ENABLE_COLIBRI_WEBSOCKET=1
ENABLE_SCTP=1
ENABLE_XMPP_WEBSOCKET=1
ENABLE_TRICKLE_ICE=1
ENABLE_OCTO=0
ENABLE_BREAKOUT_ROOMS=1
ENABLE_AV_MODERATION=1

# -------------------------------------------------------
# P2P — tắt để mọi luồng đều qua JVB (dễ quản lý hơn)
# -------------------------------------------------------
ENABLE_P2P=0

# -------------------------------------------------------
# Hiển thị giao diện
# -------------------------------------------------------
ENABLE_WELCOME_PAGE=1
ENABLE_PREJOIN_PAGE=0
DEFAULT_LANGUAGE=vi

# -------------------------------------------------------
# JVB STUN servers (dùng để JVB tự phát hiện IP nếu NAT)
# Nếu server có IP public tĩnh, có thể để trống
# -------------------------------------------------------
JVB_STUN_SERVERS=stun.l.google.com:19302,stun1.l.google.com:19302

# -------------------------------------------------------
# Logging
# -------------------------------------------------------
LOG_LEVEL=info
