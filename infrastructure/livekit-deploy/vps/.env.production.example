# Domain and Public IP Configuration
LIVEKIT_DOMAIN=livekit.yourdomain.com
VPS_PUBLIC_IP=your-vps-public-ip

# LiveKit Server Keys (Generate securely via: openssl rand -hex 32)
LIVEKIT_API_KEY=prodkey_livekit
LIVEKIT_API_SECRET=your_generated_secure_api_secret_here # Keep this extremely secret

# Coturn (TURN server) static credentials (Generate pass via: openssl rand -hex 16)
TURN_USER=edumeetuser
TURN_PASS=your_generated_secure_turn_password_here
