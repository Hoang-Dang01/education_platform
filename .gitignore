# ============================================================
#  education-platform — Root .gitignore
# ============================================================

# Dependencies (Thư mục dependency)
node_modules/
jspm_packages/

# Build and Distribution (Thư mục build & output)
dist/
dist-ssr/
build/
out/

# Environment files & Secrets (Các file cấu hình môi trường)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.env
!.env.template
!.env.example

# Logs and Debugging (Logs và debug)
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor / IDE configuration (Cấu hình editor/IDE)
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.user
*.workspace

# OS files (Files hệ điều hành)
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini
ehthumbs.db

# Project-specific / Nested git repositories (Đặc thù dự án)
# infrastructure/jitsi-src là source code Jitsi Meet để tham khảo (nested repo)
infrastructure/jitsi-src/
jitsi-meet/
# Thư mục config được tạo bởi Jitsi containers
infrastructure/jitsi-deploy/jitsi-config/
infrastructure/jitsi-deploy/config/


